function render08(){const runs=data.replays.filter(x=>['Q-FACT','Q-CROSS','Q-OUT'].includes(x.questionId)&&x.state==='initial-wiki'),tabs=$('#qa-tabs');tabs.replaceChildren();function select(run){$$('#qa-tabs .qa-tab').forEach(x=>x.classList.toggle('active',x.dataset.id===run.questionId));$('#qa-summary').innerHTML=`<span class="label">${esc(run.questionId)}</span><h3>${esc(run.question)}</h3><div class="path"><span>index</span><i>→</i><span>pages</span><i>→</i><span>links</span><i>→</i><span>raw</span></div><p><b>回答边界</b><br>${esc(run.boundary)}</p><p class="meta">${esc(run.outcome)}</p>`;replayMount($('#qa-terminal'),run);const b=document.createElement('button');b.className='action';b.textContent='深读保存事件与最终回答';b.onclick=()=>openDrawer({title:`${run.questionId} · ${run.state}`,identity:run.questionId,state:run.state,kind:'visible_tool_replay',path:run.tracePath,content:run.events.map(e=>`${e.sequence} · ${e.type}\n${e.text}`).join('\n\n')+'\n\n--- FINAL ANSWER ---\n'+run.answer},b);$('#qa-summary').append(b)}runs.forEach((run,i)=>{const b=document.createElement('button');b.className='qa-tab'+(i===0?' active':'');b.dataset.id=run.questionId;b.textContent=run.questionId;b.onclick=()=>select(run);tabs.append(b)});select(runs[0])}
function render09(){const r5=data.sources.find(x=>x.id==='R5'),card=$('#r5-card');card.innerHTML=`<span class="label">CREATE-NEW · R5</span><h3>${esc(r5.title)}</h3><p>${esc(clip(r5.excerpt,300))}</p>`;card.append(sourceButton(r5,'深读 R5'));const groups=[['页面变化','P1 / P5 / P7 changed','P2 / P3 / P4 / P6 / P8 unchanged'],['管理文件','index / log / manifest changed','页面总数和内链总数不变'],['回答变化','Q-FIXED 获得 R5 新证据','不把官方声明写成本机 rc.11 UI 验收']];$('#diff-groups').innerHTML=groups.map(([t,a,b])=>`<article class="card"><span class="label">${esc(t)}</span><p class="chip changed">${esc(a)}</p><p class="chip">${esc(b)}</p></article>`).join('');const before=data.replays.find(x=>x.questionId==='Q-FIXED'&&x.state==='initial-wiki'),after=data.replays.find(x=>x.questionId==='Q-FIXED'&&x.state==='updated-wiki');$('#answer-compare').innerHTML=`<article><span class="label">BEFORE · INITIAL WIKI</span><pre class="answer-box">${esc(clip(before.answer,1500))}</pre></article><article><span class="label">AFTER · UPDATED WIKI</span><pre class="answer-box">${esc(clip(after.answer,1500))}</pre></article>`}
